  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "ZeroKYC\\": "upload/system/library/zerokyc/vendor/zerokyc/zkp-sdk-php/src/",
      "ZeroKyc\\OpenCart\\": "upload/system/library/zerokyc/"
